# Copy this file to .env and fill in your values
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# CORS — frontend origin (change to your Vercel URL in production)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-portfolio.vercel.app
